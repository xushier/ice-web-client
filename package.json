{
  "name": "ice-web-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MG400 远程地线融冰控制系统 — 主控机柜终端模拟器（Web / Docker）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "node node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "build": "npm run build:web && npm run build:server",
    "build:web": "node node_modules/vite/bin/vite.js build",
    "build:server": "node node_modules/esbuild/bin/esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "start": "node dist/server.cjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.10",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "zustand": "^5.0.8"
  }
}
